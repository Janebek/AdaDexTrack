<?xml version="1.0"?>
<launch>
  <!-- Start the xArm TF driver and camera driver separately in your ROS workspace. -->
  <arg name="namespace_prefix" default="adadextrack"/>
  <arg name="robot_base_frame" default="link_base"/>
  <arg name="robot_effector_frame" default="link_eef"/>
  <arg name="camera_frame" default="camera_color_optical_frame"/>
  <arg name="marker_frame" default="camera_marker"/>
  <arg name="image_topic" default="/camera/color/image_raw"/>
  <arg name="camera_info_topic" default="/camera/color/camera_info"/>
  <arg name="image_is_rectified" default="false"/>
  <arg name="marker_size" default="0.1"/>
  <arg name="marker_id" default="582"/>
  <arg name="freehand_robot_movement" default="true"/>
  <arg name="move_group" default="xarm6"/>

  <node name="adadextrack_aruco" pkg="aruco_ros" type="single" output="screen">
    <remap from="/camera_info" to="$(arg camera_info_topic)"/>
    <remap from="/image" to="$(arg image_topic)"/>
    <param name="image_is_rectified" value="$(arg image_is_rectified)"/>
    <param name="marker_size" value="$(arg marker_size)"/>
    <param name="marker_id" value="$(arg marker_id)"/>
    <param name="reference_frame" value="$(arg camera_frame)"/>
    <param name="camera_frame" value="$(arg camera_frame)"/>
    <param name="marker_frame" value="$(arg marker_frame)"/>
    <param name="corner_refinement" value="LINES"/>
  </node>

  <include file="$(find easy_handeye)/launch/calibrate.launch">
    <arg name="namespace_prefix" value="$(arg namespace_prefix)"/>
    <arg name="eye_on_hand" value="false"/>
    <arg name="robot_base_frame" value="$(arg robot_base_frame)"/>
    <arg name="robot_effector_frame" value="$(arg robot_effector_frame)"/>
    <arg name="tracking_base_frame" value="$(arg camera_frame)"/>
    <arg name="tracking_marker_frame" value="$(arg marker_frame)"/>
    <arg name="freehand_robot_movement" value="$(arg freehand_robot_movement)"/>
    <arg name="move_group" value="$(arg move_group)"/>
    <arg name="robot_velocity_scaling" value="0.1"/>
    <arg name="robot_acceleration_scaling" value="0.1"/>
  </include>
</launch>
